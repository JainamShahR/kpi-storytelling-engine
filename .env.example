# Anomaly detection
SEASONAL_PERIOD_DAYS=7
BASELINE_WEEKS=4
ZSCORE_WINDOW_DAYS=56
ZSCORE_MIN_PERIODS=28
ZSCORE_THRESHOLD=3.0
MIN_RELATIVE_CHANGE=0.05

# Retrieval
TOP_K=3
RETRIEVAL_WINDOW_DAYS=3
MIN_SIMILARITY=0.10

# Confidence
CONF_WEIGHT_ANOMALY=0.4
CONF_WEIGHT_CONTRIBUTION=0.3
CONF_WEIGHT_EVIDENCE=0.3
CONF_Z_CAP=6.0
CONF_EVIDENCE_CAP=0.5

# Local LLM
LLM_ENABLED=true
OLLAMA_URL=http://localhost:11434
# Use qwen3:4b or a smaller model on laptops without a GPU
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
NUMBER_TOLERANCE=0.005
